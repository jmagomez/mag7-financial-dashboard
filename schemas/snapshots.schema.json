{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jmagomez.github.io/mag7-financial-dashboard/schemas/snapshots.schema.json",
  "title": "history/snapshots.json — um snapshot por pregão",
  "type": "object",
  "required": ["snapshots"],
  "$defs": {
    "perTicker": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z]{2,5}$"},
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    }
  },
  "properties": {
    "_doc": {"type": "string"},
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "prices": {"$ref": "#/$defs/perTicker"},
          "marketCapB": {"$ref": "#/$defs/perTicker"},
          "cds": {"$ref": "#/$defs/perTicker"},
          "quality": {
            "type": "object",
            "required": ["pricesTier", "cdsCount", "cdsAvgAgeDays", "cdsMaxAgeDays", "cdsStale"],
            "additionalProperties": false,
            "properties": {
              "pricesTier": {"enum": ["primary", "secondary", "derived"]},
              "cdsCount": {"type": "integer", "minimum": 1, "maximum": 7},
              "cdsAvgAgeDays": {"type": "number", "minimum": 0},
              "cdsMaxAgeDays": {"type": "integer", "minimum": 0},
              "cdsStale": {"type": "integer", "minimum": 0, "maximum": 7}
            }
          },
          "note": {"type": "string"}
        },
        "dependentRequired": {"prices": ["marketCapB"], "marketCapB": ["prices"]}
      }
    }
  }
}
