{
  "name": "mag7-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front-end (Vite + TypeScript) do dashboard Magnificent 7. Fase 1: núcleo financeiro tipado e testado; a UI ainda é o index.html da raiz.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
