{
  "name": "mag7-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front-end (Vite + TypeScript) do dashboard Magnificent 7. Núcleo financeiro tipado e testado, UI em SVG próprio e deploy no GitHub Pages.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.7"
  }
}
